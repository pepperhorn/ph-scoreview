{
  "kitVersion": "v3",
  "DOCS": "docs",
  "DECISIONS": "docs/decisions",
  "LEDGER": "docs/wip/LEDGER.md",
  "DECISIONS_REL": "decisions",
  "LEDGER_REL": "wip/LEDGER.md",
  "MAIN_BRANCH": "main",
  "VERIFY_CMD": "npm run check && npm run build && npm run test:manifest && npm run test:validation",
  "WORKTREE_SETUP": "npm ci && npx playwright-core install chromium (no .env needed; /tests/ and /examples/ are gitignored, so copy any local test edits back to the main checkout)",
  "PORT_BASE": "5200",
  "REMOTE": "origin",
  "MERGE": "merge",
  "GBRAIN_PROJECT": "projects/scoreflow-music-reader",
  "IMPL_PROVIDER": "codex",
  "IMPL_MODEL": "gpt-6.1-sol",
  "IMPL_OPTIONS": "{\"reasoningEffort\": \"high\"}",
  "ALT_PROVIDER": "claudeAgent",
  "ALT_MODEL": "claude-sonnet-5-5",
  "ALT_OPTIONS": "{\"effort\": \"high\"}",
  "REVIEW_PROVIDER": "claudeAgent",
  "REVIEW_MODEL": "claude-opus-5-5",
  "REVIEW_OPTIONS": "{\"effort\": \"high\"}",
  "ALT_REVIEW_PROVIDER": "codex",
  "ALT_REVIEW_MODEL": "gpt-6.1-sol",
  "ALT_REVIEW_OPTIONS": "{\"reasoningEffort\": \"high\"}",
  "AUTO_MERGE": "small",
  "AUTO_MERGE_MAX_LINES": "50",
  "SWEEP_PRS": true,
  "SCAN_DAYS": 7,
  "STOP_MAX_BLOCKS": 3
}
