    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "pepperscore": ">=0.5.0"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "immer": "^10.1.1",
    "zustand": "^5.0.0",
    "zod": "^4.0.0",
    "nanoid": "^3.3.0"
  },
  "devDependencies": {
    "vitest": "^3.0.0",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.0",
    "verovio": "6.3.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pepperhorn/ph-scoreview.git",
