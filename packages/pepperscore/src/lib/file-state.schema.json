{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scoreflow.local/schemas/file-state-v2.json",
  "title": "Scoreflow per-score settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source",
    "lastOpened",
    "settings",
    "parts"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "size",
        "sha256",
        "format"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Original file bytes for opened files; for text sources (sample, pasted ABC, musicXml prop) the hash of `<format>:<text>`."
        },
        "format": {
          "type": "string"
        }
      }
    },
    "lastOpened": {
      "type": "number",
      "minimum": 0,
      "description": "Epoch ms of the last open; only the 200 most recently opened scores are kept."
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "notationFont",
        "barsPerLine",
        "overlap",
        "names",
        "chordSymbols",
        "inferChordSymbols",
        "counts",
        "subdivisions",
        "bpm"
      ],
      "properties": {
        "mode": {
          "enum": [
            "portrait",
            "landscape"
          ]
        },
        "notationFont": {
          "enum": [
            "Bravura",
            "Petaluma"
          ]
        },
        "barsPerLine": {
          "oneOf": [
            {
              "const": "auto"
            },
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          ]
        },
        "overlap": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "names": {
          "type": "boolean"
        },
        "chordSymbols": {
          "type": "boolean"
        },
        "inferChordSymbols": {
          "type": "boolean"
        },
        "counts": {
          "type": "boolean"
        },
        "subdivisions": {
          "type": "boolean"
        },
        "annotationFont": {
          "enum": [
            "Sans",
            "Serif",
            "Mono"
          ]
        },
        "namesSize": {
          "enum": [
            "xs",
            "sm",
            "md",
            "rg",
            "lg",
            "xl"
          ],
          "description": "Note name text size. Steps smallest to largest; 'rg' (regular) is the default. Optional; readers default a missing or unknown value to 'rg'."
        },
        "chordSymbolsSize": {
          "enum": [
            "xs",
            "sm",
            "md",
            "rg",
            "lg",
            "xl"
          ],
          "description": "Chord symbol text size (source and inferred). Steps smallest to largest; 'rg' (regular) is the default. Optional; readers default a missing or unknown value to 'rg'."
        },
        "countsSize": {
          "enum": [
            "xs",
            "sm",
            "md",
            "rg",
            "lg",
            "xl"
          ],
          "description": "Beat count text size (on-beat counts). Steps smallest to largest; 'rg' (regular) is the default. Optional; readers default a missing or unknown value to 'rg'."
        },
        "subdivisionsSize": {
          "enum": [
            "xs",
            "sm",
            "md",
            "rg",
            "lg",
            "xl"
          ],
          "description": "Subdivision count text size (the e/&/a counts between beats). Steps smallest to largest; 'rg' (regular) is the default. Optional; readers default a missing or unknown value to 'rg'."
        },
        "bpm": {
          "type": "number",
          "minimum": 30,
          "maximum": 240,
          "description": "Playback BPM. Writers clamp to 30-240; readers clamp out-of-range saved values instead of discarding the state."
        },
        "semitones": {
          "type": "integer",
          "minimum": -12,
          "maximum": 12
        },
        "scorePitch": {
          "enum": [
            "written",
            "concert"
          ]
        },
        "keyFlip": {
          "type": "boolean",
          "description": "Spell the transposed view in the enharmonic key (e.g. Gb major instead of F# major). Optional; readers default it to false."
        },
        "tabView": {
          "enum": [
            "notation",
            "tab",
            "both"
          ],
          "description": "Which staves guitar parts show: notation, TAB or both. Optional; a reader without it keeps its current view."
        },
        "tabTuning": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "minItems": 4,
          "maxItems": 8,
          "description": "Open-string MIDI pitches of generated TAB, low to high (4 to 8 strings). Optional; a reader without it keeps its current tuning (standard [40, 45, 50, 55, 59, 64] by default)."
        },
        "capo": {
          "type": "integer",
          "minimum": 0,
          "maximum": 12,
          "description": "Capo fret of generated TAB (frets are relative to it). Optional; a reader without it keeps its current capo."
        }
      }
    },
    "parts": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "visible",
          "instrument"
        ],
        "properties": {
          "visible": {
            "type": "boolean"
          },
          "instrument": {
            "enum": [
              "piano",
              "guitar",
              "bassguitar",
              "double-bass",
              "drum-kit",
              "alto-saxophone",
              "tenor-saxophone",
              "bari-saxophone",
              "flute",
              "clarinet",
              "trumpet",
              "trombone",
              "violin",
              "viola",
              "cello",
              "microphone"
            ]
          },
          "gmSoundfont": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "volume": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "switch": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "level",
              "autoRange"
            ],
            "properties": {
              "instrument": {
                "enum": [
                  "piano",
                  "guitar",
                  "bassguitar",
                  "double-bass",
                  "drum-kit",
                  "alto-saxophone",
                  "tenor-saxophone",
                  "bari-saxophone",
                  "flute",
                  "clarinet",
                  "trumpet",
                  "trombone",
                  "violin",
                  "viola",
                  "cello",
                  "microphone"
                ],
                "description": "Shown as this instrument; absent = as written. Readers drop a switch to the drum kit."
              },
              "level": {
                "enum": [
                  "beginner",
                  "intermediate",
                  "advanced"
                ]
              },
              "autoRange": {
                "type": "boolean",
                "description": "Fit phrases outside the level's range by an octave."
              },
              "octaves": {
                "type": "object",
                "additionalProperties": {
                  "enum": [
                    12,
                    -12
                  ]
                },
                "description": "The reader's octave moves by Score note id."
              },
              "sound": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "instrument"
                ],
                "properties": {
                  "instrument": {
                    "enum": [
                      "piano",
                      "guitar",
                      "bassguitar",
                      "double-bass",
                      "drum-kit",
                      "alto-saxophone",
                      "tenor-saxophone",
                      "bari-saxophone",
                      "flute",
                      "clarinet",
                      "trumpet",
                      "trombone",
                      "violin",
                      "viola",
                      "cello",
                      "microphone"
                    ],
                    "description": "The picked GM sound's icon id (drum-kit without gmSoundfont = the drum kit)."
                  },
                  "gmSoundfont": {
                    "type": "string",
                    "pattern": "^[a-z0-9_]+$"
                  }
                },
                "description": "The playback sound picked while the part is switched (overrides the instrument's main sound); readers ignore it without an instrument or when unusable."
              }
            },
            "description": "The reader's instrument switch of this staff part. Optional (added in version 2); readers drop an unusable one, so the part opens as written."
          }
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zoom",
        "zoomDevice"
      ],
      "properties": {
        "zoom": {
          "type": "number",
          "minimum": 0.02,
          "maximum": 4,
          "description": "Absolute stave scale: rendered px per Verovio layout unit at scale 100 (1 = a 72px staff)."
        },
        "zoomDevice": {
          "enum": [
            "desktop",
            "compact"
          ],
          "description": "Device class the zoom was chosen on; it is only restored on the same class."
        }
      },
      "description": "Only a user-chosen zoom (slider or pinch) is saved; without it the device default (or many-staff height fit) applies and is re-resolved on resize."
    }
  },
  "description": "Version 2 record in the IndexedDB database `scoreflow`, object store `scores`, keyed by source.sha256 (see src/lib/score-db.ts). Version 1 records (localStorage `scoreflow-file-v1:<sha256>`, zoom inside settings as a width-fit multiplier) are migrated on first read. Only settings and hashes are stored, never score content."
}
